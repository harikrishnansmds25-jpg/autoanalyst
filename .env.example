# All settings are optional; defaults live in autoanalyst/config.py.
AUTOANALYST_MAX_FILE_MB=50
AUTOANALYST_MAX_ROWS=200000
AUTOANALYST_SEED=42
AUTOANALYST_RUNS_DIR=runs
AUTOANALYST_RETENTION_DAYS=7

# Validator thresholds
AUTOANALYST_MAX_ROW_DROP_FRAC=0.10
AUTOANALYST_MAX_MEAN_SHIFT_STD=0.25
AUTOANALYST_LEAKAGE_CORR=0.98

# LLM: hosted (Gemini), ollama (local) or mock (offline, deterministic)
AUTOANALYST_LLM_PROVIDER=hosted
GEMINI_API_KEY=
AUTOANALYST_HOSTED_MODEL=gemini-flash-latest
AUTOANALYST_OLLAMA_HOST=http://localhost:11434
AUTOANALYST_OLLAMA_MODEL=qwen2.5:7b
AUTOANALYST_LLM_TEMPERATURE=0.1
